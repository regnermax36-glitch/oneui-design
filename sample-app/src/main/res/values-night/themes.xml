<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Samsung Music Player One UI 10.0 Dark Theme -->
    <style name="SamsungMusicTheme" parent="OneUITheme">
        <item name="colorPrimary">@color/samsung_blue_light</item>
        <item name="colorPrimaryVariant">@color/samsung_blue</item>
        <item name="colorSecondary">@color/samsung_blue_light</item>
        <item name="colorSecondaryVariant">@color/player_accent_variant</item>
        <item name="colorSurface">@color/player_surface_dark</item>
        <item name="colorBackground">@color/player_background_dark</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        
        <!-- Samsung One UI 10.0 Dark Mode specific attributes -->
        <item name="android:windowBackground">@color/player_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    
    <!-- Dark Mode Glassy UI Components -->
    <style name="GlassyCardStyle">
        <item name="android:background">@drawable/glassy_card_background_dark</item>
        <item name="android:elevation">8dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
    </style>
    
    <style name="GlassyButtonStyle" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/glassy_button_background_dark</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    
    <!-- Dark Mode Text Styles -->
    <style name="SongTitleText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:fontFamily">sec-roboto-light</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <style name="ArtistNameText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:fontFamily">sec-roboto-light</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    
    <!-- Dark Mode Splash Screen Theme -->
    <style name="SplashTheme" parent="SamsungMusicTheme">
        <item name="android:windowBackground">@drawable/splash_background_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
