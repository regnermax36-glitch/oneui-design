<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Samsung Music Player One UI 10.0 Theme -->
    <style name="SamsungMusicTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/samsung_blue</item>
        <item name="colorPrimaryVariant">@color/samsung_blue_dark</item>
        <item name="colorSecondary">@color/samsung_blue_light</item>
        <item name="colorSecondaryVariant">@color/player_accent_variant</item>
        <item name="colorSurface">@color/player_surface</item>
        <item name="android:colorBackground">@color/player_background</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Samsung One UI 10.0 specific attributes -->
        <item name="android:windowBackground">@color/player_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    
    <!-- Glassy UI Components -->
    <style name="GlassyCardStyle">
        <item name="android:background">@drawable/glassy_card_background</item>
        <item name="android:elevation">8dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
    </style>
    
    <style name="GlassyButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/glassy_button_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    

    
    <!-- Splash Screen Theme -->
    <style name="SplashTheme" parent="SamsungMusicTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
