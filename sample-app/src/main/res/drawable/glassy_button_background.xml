<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="@color/samsung_blue_light"
                android:endColor="@color/samsung_blue"
                android:angle="135" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/samsung_blue" />
        </shape>
    </item>
    
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="@color/glass_overlay"
                android:endColor="@color/glass_background"
                android:angle="135" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/control_disabled" />
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="@color/glass_surface"
                android:endColor="@color/glass_background"
                android:angle="135" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_overlay" />
        </shape>
    </item>
    
</selector>
