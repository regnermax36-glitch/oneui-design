<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background">

    <!-- Music Library ListView -->
    <ListView
        android:id="@+id/song_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glassy_card_background"
        android:elevation="4dp"
        android:padding="8dp"
        android:divider="@color/glass_overlay"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:fastScrollEnabled="true"
        android:visibility="gone" />

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/samsung_blue"
        android:visibility="gone" />

    <!-- Status/Placeholder Text -->
    <TextView
        android:id="@+id/library_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Music Library\n\nLoading..."
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sec-roboto-light"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

</RelativeLayout>
