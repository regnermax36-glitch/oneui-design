<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:fitsSystemWindows="true">

    <!-- Samsung Logo -->
    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_centerInParent="true"
        android:src="@drawable/samsung_logo"
        android:contentDescription="@string/samsung_music"
        android:alpha="0" />

    <!-- Samsung Music Branding -->
    <TextView
        android:id="@+id/branding_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo_image"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:text="@string/samsung_music"
        android:textSize="24sp"
        android:textColor="@color/samsung_blue"
        android:fontFamily="sec-roboto-light"
        android:alpha="0" />

    <!-- Powered by Samsung -->
    <TextView
        android:id="@+id/powered_by_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/branding_text"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="@string/powered_by_samsung"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sec-roboto-light"
        android:alpha="0" />

    <!-- One UI 10.0 Version -->
    <TextView
        android:id="@+id/version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:text="@string/oneui_10"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sec-roboto-light"
        android:alpha="0" />

    <!-- Glassy overlay effect -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/glass_overlay"
        android:alpha="0.3" />

</RelativeLayout>
